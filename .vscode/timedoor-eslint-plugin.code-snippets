{
  "Create Custom Rule": {
    "prefix": "newrule",
    "body": [
      "import { createRule, withTemplateVisitor } from \"../utils/rule\";",
      "",
      "export const $1 = createRule({",
      "  name: \"$2\",",
      "  meta: {",
      "\tdocs: {",
      "\t  description: \"\",",
      "\t},",
      "\ttype: \"suggestion\",",
      "\tmessages: {},",
      "\tschema: [],",
      "\tdefaultOptions: [],",
      "\thasSuggestions: false,",
      "  },",
      "  create: (context) => {",
      "\treturn withTemplateVisitor(context, {",
      "\t  script: {},",
      "\t});",
      "  },",
      "});",
      "",
    ],
  },
  "Create Rule Test": {
    "prefix": "newruletest",
    "body": [
      "import { $1 } from \"../rules/$2\";",
      "import { createVueTester } from \"../utils/tester\";",
      "",
      "const ruleTester = createVueTester();",
      "",
      "ruleTester.run(",
      "  \"$2\",",
      "  $1,",
      "  {",
      "\t// ============================================================================",
      "\t// VALID TEST CASES",
      "\t// Case that should PASS validation",
      "\t// ============================================================================",
      "\tvalid: [],",
      "",
      "\t// ============================================================================",
      "\t// INVALID TEST CASES",
      "\t// Case that should FAIL and trigger ESLint errors",
      "\t// ============================================================================",
      "\tinvalid: [],",
      "  },",
      ");",
      "",
    ],
  },
}
